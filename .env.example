# Docker port configuration
# Port exposed on the host.
APP_PORT=8000

# Port Django listens on inside the container.
CONTAINER_PORT=8000

# Examples:
# Host 8080 -> container 8000:
# APP_PORT=8080
# CONTAINER_PORT=8000
#
# Host 8080 -> container 9000:
# APP_PORT=8080
# CONTAINER_PORT=9000

# Allow local and trusted LAN hostnames/IPs (replace 192.168.1.50 with yours).
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.50
# Do not expose the development server directly to the internet.
